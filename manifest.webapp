{
	"version": "1.0.2",
	"name": "Cobolt",
	"description": "Your platform, your games.",
	"launch_path": "/index.html",
	"icons": {
		"56": "/Images/logos/kaiosapplogo_56.png",
		"112": "/Images/logos/kaiosapplogo_112.png"
	},
	"developer": {
		"name": "Cobolt Team",
		"url": "https://github.com/Cobotl"
	},
	"type": "privileged",
	"orientation": "portrait-primary",
	"permissions": {
		"systemXHR": {
			"description": "Talk to the Cobolt server"
		}
	},
	"default_locale": "en",
	"locales": {
		"en": {
			"name": "Cobolt",
			"subtitle": "Your platform, your games.",
			"description": "Cobolt is a social media that has games and a easy way to install mods for those games without any trouble."
		}
	}
}
