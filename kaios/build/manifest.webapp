{
	"version": "2.0.0",
	"name": "Nihonoari",
	"theme_color": "#f34137",
	"description": "Your platform, your games.",
	"launch_path": "/index.html",
	"icons": {
		"56": "/Images/logos/favicon.svg",
		"112": "/Images/logos/favicon.svg"
	},
	"developer": {
		"name": "Cobolt Team",
		"url": "https://github.com/Cobotl"
	},
	"type": "web",
	"dependencies": { "ads-sdk": "1.5.5" },
	"installs_allowed_from": ["*"],
	"locales": {
		"en-US": {
			"name": "Cobolt",
			"subtitle": "Your platform, your games.",
			"description": "Cobolt is a social media that has games and a easy way to install mods for those games without any trouble."
		}
	},
	"default_locale": "en"
}
